{
  "name": "cats-pajamas-club",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "node devtools/check.mjs",
    "dev": "vite",
    "predev": "node scripts/generate-gallery-manifest.mjs",
    "build": "vite build && node scripts/prerender-menu.mjs && node scripts/prerender-404.mjs && node scripts/prerender-home.mjs",
    "prebuild": "node scripts/generate-gallery-manifest.mjs",
    "gallery": "node scripts/generate-gallery-manifest.mjs",
    "preview": "vite preview",
    "start:api": "node server.js",
    "start:bot": "node bot-start.js",
    "test:security": "node devtools/auth_security_test.mjs && node devtools/booking_security_test.mjs && node devtools/bar_menu_security_test.mjs && node devtools/schema_security_test.mjs && node devtools/booking_transaction_contract_test.mjs",
    "test:photos": "node devtools/event_photo_draft_test.mjs && node devtools/event_delete_shared_photos_test.mjs && node devtools/event_delete_cleanup_ui_test.mjs",
    "test:photos:browser": "node devtools/event_photo_browser_test.mjs",
    "test:a11y": "node devtools/floorplan_keyboard_test.mjs && node devtools/auth_dialog_test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "grammy": "^1.44.0",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "vite": "^5.4.11"
  }
}
